{
	"name": "spotify-mcp-cloudflare",
	"version": "0.8.0",
	"description": "Spotify MCP server for Cloudflare Workers and local stdio - token-efficient tools, typed + tested",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"stdio": "tsx src/stdio.ts",
		"login": "tsx src/stdio.ts login",
		"signout": "tsx src/stdio.ts signout",
		"type-check": "wrangler types --include-env=false && tsc --noEmit && tsc -p tsconfig.node.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run && vitest run --config vitest.node.config.ts",
		"test:watch": "vitest",
		"test:local": "vitest run --config vitest.node.config.ts",
		"test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul --coverage.include='src/**' --coverage.exclude='src/**/*.test.ts' --coverage.exclude='src/fake-spotify.ts' --coverage.exclude='src/local/**' --coverage.exclude='src/stdio.ts'",
		"check": "pnpm lint && pnpm lint:md && pnpm type-check && pnpm check:meta && pnpm test && pnpm check:size && pnpm check:sec",
		"e2e": "node --experimental-strip-types scripts/e2e.ts",
		"api:watch": "node --experimental-strip-types scripts/spotify-api-watch.ts",
		"check:meta": "node --experimental-strip-types scripts/check-meta.ts",
		"make:icon": "node --experimental-strip-types scripts/make-icon.ts",
		"check:size": "pnpm exec wrangler deploy --dry-run --outdir /tmp/spotify-mcp-size-check 2>&1 | node --experimental-strip-types scripts/check-size.ts",
		"lint:md": "markdownlint-cli2 \"*.md\"",
		"check:sec": "gitleaks git --no-banner && pnpm audit --prod --audit-level high"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "^0.10.4",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@modelcontextprotocol/server": "2.4.0",
		"agents": "^0.32.0",
		"hono": "^4.13.14",
		"tsx": "4.23.15",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@cloudflare/vitest-plugin": "^1.4.11",
		"@types/node": "^22.20.5",
		"@vitest/coverage-istanbul": "^5.0.5",
		"markdownlint-cli2": "^0.23.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.156.0"
	},
	"packageManager": "pnpm@11.17.0"
}
