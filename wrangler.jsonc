/**
 * Wrangler config for the Spotify remote MCP server.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (set with `pnpm wrangler secret put <NAME>`):
 *   SPOTIFY_CLIENT_ID      - your Spotify app's Client ID
 *   SPOTIFY_CLIENT_SECRET  - your Spotify app's Client Secret
 *   COOKIE_ENCRYPTION_KEY  - random string used to sign approval cookies
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spotify-mcp-cloudflare",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// v1 held per-session token copies for McpAgent. The Worker is stateless
	// now and the OAuth grant owns the tokens, so v2 deletes that class and its
	// storage on deploy. Keep both entries: migrations are append-only history.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SpotifyMCP"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"SpotifyMCP"
			]
		}
	],
	"workers_dev": true,
	// Custom domain: requires the zone to be hosted on Cloudflare (jamiedubs.com
	// is currently on Namecheap DNS). Uncomment once the zone is on this account.
	// "routes": [{ "pattern": "spotify-mcp.jamiedubs.com", "custom_domain": true }],
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "f89b9fa733b0465da718ca3a01fa51a5"
		}
	],
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	}
}